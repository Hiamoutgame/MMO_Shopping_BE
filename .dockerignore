# ---- version control / CI ---------------------------------------------------
.git
.github
.gitignore

# ---- dependencies & build artifacts ----------------------------------------
node_modules
dist
build
coverage
*.tsbuildinfo

# ---- environment files & secrets (never bake these into an image) ----------
.env
.env.*
!.env.example

