playwright.verify.config.ts
src/**/*.spec.ts

# ---- docs & editor config ---------------------------------------------------
*.md
docs
.vscode
.idea
Dockerfile*
docker-compose*.yml
.dockerignore

# ---- logs -------------------------------------------------------------------
*.log
npm-debug.log*
