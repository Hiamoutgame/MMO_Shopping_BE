# Local development. Copy to .env; never commit real credentials.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# npm start connects to PostgreSQL on the host.
# Compose sets DB_HOST=db and uses POSTGRES_* instead.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=mmo
DB_PASSWORD=mmo_dev_password
DB_DATABASE=mmo_shopping
DB_SSL=false
POSTGRES_USER=mmo
POSTGRES_PASSWORD=mmo_dev_password
POSTGRES_DB=mmo_shopping
POSTGRES_PORT=5432
APP_PORT=3000
RUN_MIGRATIONS=true
RUN_SEED_ADMIN=false

JWT_SECRET=local-only-jwt-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
INVENTORY_ENCRYPTION_KEY=local-only-inventory-key
PAYMENT_CALLBACK_SECRET=local-only-payment-secret
INTEGRATION_ENCRYPTION_KEY=local-only-integration-key
HOANPHI_API_BASE_URL=https://hoanphi247.vn/api/v1/openapi
HOANPHI_TIMEOUT_MS=10000

SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=MMO Shopping API
SWAGGER_DESCRIPTION=MMO Shopping Backend API
SWAGGER_VERSION=1.0.0

# Optional: configure before running make seed-admin.
SEED_ADMIN_EMAIL=admin@mmo-shopping.local
SEED_ADMIN_PASSWORD=local-only-admin-password
SEED_ADMIN_NAME=Admin

# --- SePay: nạp tiền chuyển khoản (xem docs/business/sepay-deposit.md) -------
# Webhook SePay gửi header "Authorization: Apikey <SEPAY_WEBHOOK_API_KEY>"
SEPAY_WEBHOOK_API_KEY=change-me-openssl-rand-hex-24
# API token (my.sepay.vn > API Access) dùng cho sync/đối soát
SEPAY_API_TOKEN=
# Tên ngân hàng theo qr.sepay.vn (VD: MBBank, Vietcombank, ACB)
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_PREFIX=MMO
SEPAY_AUTO_SYNC_INTERVAL_MS=300000
DEPOSIT_MIN_AMOUNT=10000
DEPOSIT_MAX_AMOUNT=1000000000
DEPOSIT_EXPIRES_MINUTES=30
