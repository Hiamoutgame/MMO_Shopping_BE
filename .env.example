NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DB_DATABASE=mmo_shopping

SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=replace-with-api-title
SWAGGER_DESCRIPTION=replace-with-api-description
SWAGGER_VERSION=1.0.0

JWT_SECRET=replace-with-jwt-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

INVENTORY_ENCRYPTION_KEY=replace-with-inventory-encryption-key
PAYMENT_CALLBACK_SECRET=replace-with-payment-callback-secret

SEED_ADMIN_EMAIL=replace-with-admin-email
SEED_ADMIN_PASSWORD=replace-with-admin-password
SEED_ADMIN_NAME=replace-with-admin-name
