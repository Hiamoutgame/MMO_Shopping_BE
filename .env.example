CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# PostgreSQL Connection Instructions:
# 1. Start PostgreSQL:
#    - Docker: docker start postgres (or docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=MyStrongPassword123@ postgres)
#    - Windows Service: net start postgresql-x64-16
#    - Manual: pg_ctl start
#
# 2. Create database:
#    psql -U postgres -c "CREATE DATABASE MMO;"
#
# 3. Run migrations:
#    npm run typeorm:migration:run
#
# 4. Seed data:
#    npm run seed:chung-suc
#
# Demo Accounts (after seed):
#   - User: user@demo.com / Demo@123456
#   - Seller: seller@demo.com / Demo@123456
#   - Admin: admin@mmo-shopping.local / Admin@123456
