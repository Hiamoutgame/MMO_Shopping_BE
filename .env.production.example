# =============================================================================
# Template for a Docker/production deployment.
#   cp .env.production.example .env      (the file .env is git-ignored)
#   ...edit the values, then: docker compose up -d
#
# NOTE: docker compose reads .env automatically for ${VAR} interpolation.
#       Generate strong secrets with:  openssl rand -hex 32
# =============================================================================

# --- PostgreSQL (used by the compose "db" service AND by the app) ------------
POSTGRES_USER=mmo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mmo_shopping
POSTGRES_PORT=5432

# --- app ---------------------------------------------------------------------
APP_PORT=3000
# Chỉ nghe loopback; Nginx proxy vào. Đặt 0.0.0.0 nếu không có reverse proxy.
APP_BIND=127.0.0.1
TRUST_PROXY=true
APP_IMAGE=mmo-shopping-be:local
RUN_MIGRATIONS=true
RUN_SEED_ADMIN=false

# --- security ----------------------------------------------------------------
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
INVENTORY_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
PAYMENT_CALLBACK_SECRET=change-me-openssl-rand-hex-32
INTEGRATION_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# --- cors --------------------------------------------------------------------
CORS_ORIGIN=https://your-frontend.example.com

# --- swagger -----------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# --- hoanphi integration -----------------------------------------------------
HOANPHI_API_BASE_URL=https://hoanphi247.vn/api/v1/openapi
HOANPHI_TIMEOUT_MS=10000

# --- optional admin seed (only when RUN_SEED_ADMIN=true) ---------------------
SEED_ADMIN_EMAIL=admin@mmo-shopping.local
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin User

# --- SePay: nạp tiền chuyển khoản (xem docs/business/sepay-deposit.md) -------
# Webhook SePay gửi header "Authorization: Apikey <SEPAY_WEBHOOK_API_KEY>"
SEPAY_WEBHOOK_API_KEY=change-me-openssl-rand-hex-24
# API token (my.sepay.vn > API Access) dùng cho sync/đối soát
SEPAY_API_TOKEN=
# Tên ngân hàng theo qr.sepay.vn (VD: MBBank, Vietcombank, ACB)
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_PREFIX=MMO
SEPAY_AUTO_SYNC_INTERVAL_MS=300000
DEPOSIT_MIN_AMOUNT=10000
DEPOSIT_MAX_AMOUNT=1000000000
DEPOSIT_EXPIRES_MINUTES=30
